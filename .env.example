# Required ---------------------------------------------------------------
# Neon pooled connection string (host contains "-pooler"). Used by the app.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/streaks?sslmode=require
# Neon direct (unpooled) connection string. Used only by `make migrate`.
DATABASE_URL_DIRECT=postgresql://user:password@ep-example.region.aws.neon.tech/streaks?sslmode=require
# Shared secret sent by the web app in the X-Streaks-Secret header.
# Generate one with: openssl rand -hex 32
API_SECRET=change-me

# Optional ---------------------------------------------------------------
API_PORT=8080
SYNC_INTERVAL=6h

# GitHub sync: fine-grained PAT with "Events" user permission (read).
GITHUB_USERNAME=
GITHUB_TOKEN=

# Google Tasks: a "Web application" OAuth client. Connect accounts on the Accounts page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored refresh tokens. Not the same as API_SECRET, which reaches the browser.
# Generate one with: openssl rand -hex 32
# Keep it safe: changing it means reconnecting every account.
GOOGLE_TOKEN_KEY=
# Must match the OAuth client exactly. Only change this if you change the web port or host.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/oauth/google/callback
