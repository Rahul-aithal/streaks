# Required ---------------------------------------------------------------
# Neon pooled connection string (host contains "-pooler"). Used by the app.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/streaks?sslmode=require
# Neon direct connection string (no "-pooler"). Used only by `make migrate`.
DATABASE_URL_DIRECT=postgresql://user:password@ep-example.region.aws.neon.tech/streaks?sslmode=require

# Sign-in: a "Web application" OAuth client from Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored Google and GitHub tokens. Generate one with: openssl rand -hex 32
# Keep it safe: if it changes, everyone has to reconnect Google and relink GitHub.
GOOGLE_TOKEN_KEY=

# Optional ---------------------------------------------------------------
# A GitHub OAuth app, for the Connect GitHub button. Without one, GitHub can only
# be linked by pasting a token.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
API_PORT=8080
SYNC_INTERVAL=6h
# Must match the OAuth client exactly. Only change this if you change the web port or host.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/oauth/google/callback
GITHUB_REDIRECT_URI=http://localhost:5173/api/oauth/github/callback

# Reminder emails at 11 AM, 5 PM and 10 PM IST. Leave both RESEND_API_KEY and
# SMTP_HOST empty to turn them off.
# Resend (HTTPS API): an API key with Sending access, and EMAIL_FROM=onboarding@resend.dev
# (or an address on your verified domain).
RESEND_API_KEY=
# Or SMTP, e.g. Gmail: SMTP_HOST=smtp.gmail.com, your address as SMTP_USERNAME,
# and an app password (myaccount.google.com/apppasswords) as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Required to send. Defaults to SMTP_USERNAME.
EMAIL_FROM=

# Production only (see "Deploying for free" in the README) -------------------
# Turns off the built-in sync and reminder timers and lets the Worker's cron call
# /jobs/* with this as a bearer token. Leave empty for `make dev`.
JOBS_SECRET=
# Where the API listens. Defaults to $PORT on every interface if PORT is set,
# else 127.0.0.1:$API_PORT.
# LISTEN_ADDR=
