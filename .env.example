# Required ---------------------------------------------------------------
# Neon pooled connection string (host contains "-pooler"). Used by the app.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/streaks?sslmode=require
# Neon direct connection string (no "-pooler"). Used only by `make migrate`.
DATABASE_URL_DIRECT=postgresql://user:password@ep-example.region.aws.neon.tech/streaks?sslmode=require

# Sign-in: a "Web application" OAuth client from Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored Google and GitHub tokens. Generate one with: openssl rand -hex 32
# Keep it safe: if it changes, everyone has to reconnect Google and relink GitHub.
GOOGLE_TOKEN_KEY=

# Optional ---------------------------------------------------------------
# A GitHub OAuth app, for the Connect GitHub button. Without one, GitHub can only
# be linked by pasting a token.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
API_PORT=8080
SYNC_INTERVAL=6h
# Must match the OAuth client exactly. Only change this if you change the web port or host.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/oauth/google/callback
GITHUB_REDIRECT_URI=http://localhost:5173/api/oauth/github/callback

# Reminder emails at 11 AM, 5 PM and 10 PM IST. Leave SMTP_HOST empty to turn them off.
# For Gmail: SMTP_HOST=smtp.gmail.com, your address as SMTP_USERNAME, and an app
# password (myaccount.google.com/apppasswords) as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME.
EMAIL_FROM=
