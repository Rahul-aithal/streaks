# Required ---------------------------------------------------------------
# Neon pooled connection string (host contains "-pooler"). Used by the app.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/streaks?sslmode=require
# Neon direct (unpooled) connection string. Used only by `make migrate`.
DATABASE_URL_DIRECT=postgresql://user:password@ep-example.region.aws.neon.tech/streaks?sslmode=require
# Shared secret sent by the web app in the X-Streaks-Secret header.
# Generate one with: openssl rand -hex 32
API_SECRET=change-me

# Optional ---------------------------------------------------------------
API_PORT=8080
SYNC_INTERVAL=6h

# GitHub sync: fine-grained PAT with "Events" user permission (read).
GITHUB_USERNAME=
GITHUB_TOKEN=

# Google Tasks sync: see README. Get the refresh token from `make google-auth`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
