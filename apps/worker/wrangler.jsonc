// The site's front door, on Cloudflare's free Workers plan:
// - serves the built web app (apps/web/dist/client) as static assets,
// - forwards /api/* to the Go API on Render,
// - tells the browser how to wake the API when it is asleep.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "streaks",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../web/dist/client",
    "binding": "ASSETS",
    // Every route that isn't a file gets index.html; the app routes in the browser.
    "not_found_handling": "single-page-application",
    // Only these reach the Worker; everything else is served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  // Served on streaks.devaithal.tech, a Custom Domain attached in the dashboard
  // (Workers > streaks > Settings > Domains & Routes), not here: deploying a
  // domain from this file needs a token with DNS access to the whole zone, and
  // CI's token can only deploy this Worker. The API only accepts that origin
  // (from GOOGLE_REDIRECT_URI on Render).
  // Keep the old workers.dev address while sign-in still redirects there.
  // Set to false once Render and the OAuth apps use streaks.devaithal.tech.
  "workers_dev": true,
  "vars": {
    // The Render service's URL, e.g. https://streaks-api.onrender.com
    "API_ORIGIN": "https://streaks-api-6v7j.onrender.com"
  },
  // No crons: a sleeping Render ignores requests from Workers, so scheduled jobs
  // run from GitHub Actions instead (.github/workflows/scheduled-jobs.yml).
  // The empty list removes the crons from earlier deploys.
  "triggers": { "crons": [] },
  "observability": { "enabled": true }
}
